<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.Setting.WebDAVBackupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             Title="WebDAVBackupWindow"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          RowSpacing="8"
          Loaded="RootGrid_Loaded"
          Unloaded="RootGrid_Unloaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!--  标题栏  -->
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.ToolboxSetting_WebDAVBackupManager}" />


        <!--  工具栏  -->
        <StackPanel Grid.Row="1"
                    Margin="8,0,8,0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="Button_Refresh"
                    Command="{x:Bind RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock Text="{x:Bind lang:Lang.WebDAVBackupWindow_Refresh}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_Download"
                    Command="{x:Bind DownloadCommand}"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" />
                    <TextBlock Text="{x:Bind lang:Lang.WebDAVBackupWindow_Download}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_Delete"
                    Command="{x:Bind DeleteCommand}"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock Text="{x:Bind lang:Lang.WebDAVBackupWindow_Delete}" />
                </StackPanel>
            </Button>
            <ProgressRing Width="24"
                          Height="24"
                          VerticalAlignment="Center"
                          IsIndeterminate="True"
                          Visibility="{x:Bind IsLoading}" />
        </StackPanel>


        <!--  文件列表  -->
        <Grid Grid.Row="2"
              Margin="8,0,8,0"
              RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="16,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.WebDAVBackupWindow_Name}" />
                <TextBlock Grid.Column="2"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.WebDAVBackupWindow_Size}" />
                <TextBlock Grid.Column="3"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.WebDAVBackupWindow_LastModified}" />
            </Grid>

            <ListView x:Name="ListView_Files"
                      Grid.Row="1"
                      ItemsSource="{x:Bind BackupFiles}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="16,0,12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WebDAVFileInfo">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Width="36"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      Checked="CheckBox_Checked"
                                      Unchecked="CheckBox_Unchecked" />
                            <TextBlock Grid.Column="1"
                                       MaxWidth="320"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind SizeText}" />
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind LastModifiedText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  空状态提示  -->
            <TextBlock Grid.Row="1"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind EmptyHint}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind EmptyHintVisibility}" />
        </Grid>


        <!--  状态栏  -->
        <TextBlock Grid.Row="3"
                   Margin="12,0,12,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind StatusText}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind StatusTextVisibility}" />


    </Grid>

</sf:WindowEx>
