<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.GameRecord.ZZZ.ZZZAvatarInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameRecord.ZZZ"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:scgz="using:Starward.Core.GameRecord.ZZZ.AvatarInfo"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <local:ZZZRarityToIconConverter x:Key="ZZZRarityToIconConverter" />
        <Style x:Key="SectionHeaderStyle" TargetType="Grid">
            <Setter Property="Padding" Value="12,9,12,9" />
            <Setter Property="Background" Value="#161616" />
            <Setter Property="CornerRadius" Value="12,12,0,0" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>
        <DataTemplate x:Key="ZZZPropertyItemTemplate" x:DataType="scgz:ZZZAvatarProperty">
            <Grid Height="30"
                  Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#A6FFFFFF"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind PropertyName}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#FFFFFF"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind local:ZZZAvatarInfoPage.PropertyBase(Base), Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#B5FF00"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind local:ZZZAvatarInfoPage.PropertyAdd(Add), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind Final}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Name="Image_Emoji"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Width="160"
                   Height="160"
                   Source="{StaticResource EmojiBangboo}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <!--  代理人列表  -->
        <Grid Grid.RowSpan="2"
              Width="346"
              Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Height="36"
                        BorderThickness="0"
                        Command="{x:Bind RefreshAvatarInfoCommand}"
                        CornerRadius="0,18,18,0"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Margin="4,0,4,0"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Grid>
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind RefreshAvatarInfoCommand.IsRunning}" />
                            <FontIcon FontSize="16"
                                      Glyph="&#xE72C;"
                                      Visibility="{x:Bind RefreshAvatarInfoCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                        </Grid>
                        <TextBlock Text="{x:Bind lang:Lang.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <Button x:Name="FilterButton"
                        Height="36"
                        BorderThickness="0"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="18">
                    <FontIcon FontSize="16"
                              Glyph="&#xE71C;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="Right">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="12" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="30"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Attribute}" />
                                    <ItemsControl x:Name="ElementFilterPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Width="30"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Specialty}" />
                                    <ItemsControl x:Name="ProfessionFilterPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
                <GridView Margin="0,0,-8,0"
                          ItemsSource="{x:Bind AvatarList}"
                          SelectionChanged="GridView_AvatarList_SelectionChanged"
                          SelectionMode="Single">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="scgz:ZZZAvatarInfo">
                            <StackPanel Width="76" Spacing="2">
                                <!--  头像卡  -->
                                <Grid Width="76"
                                      Height="94">
                                    <Border Width="76"
                                            Height="94"
                                            Background="#0A0A0A"
                                            CornerRadius="8" />
                                    <!--  背景  -->
                                    <sc:CachedImage Margin="2,2,2,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="8,8,0,0"
                                                    Source="ms-appx:///Assets/Image/ZZZ_AvatarCard_Background.png" />
                                    <!--  图片  -->
                                    <sc:CachedImage Width="72"
                                                    Height="72"
                                                    Margin="0,2,0,0"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="8,8,0,0"
                                                    Source="{x:Bind Avatar.RoleSquareUrl}"
                                                    Stretch="UniformToFill" />
                                    <!--  等级  -->
                                    <TextBlock Margin="0,0,0,2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False">
                                        <Run Text="Lv." /><Run Text="{x:Bind Avatar.Level}" />
                                    </TextBlock>
                                    <!--  星级  -->
                                    <Border Width="22"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="Black"
                                            CornerRadius="8,0,4,0">
                                        <Image Width="16"
                                               Height="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Source="{x:Bind Avatar.Rarity, Converter={StaticResource ZZZRarityToIconConverter}}" />
                                    </Border>
                                    <!--  属性  -->
                                    <Border Width="16"
                                            Height="16"
                                            Margin="4,25,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#0A0A0A"
                                            CornerRadius="8">
                                        <sc:CachedImage Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="{x:Bind local:ZZZAvatarInfoPage.ElementIconUrl(Avatar.ElementType, Avatar.SubElementType)}" />
                                    </Border>
                                    <!--  特性  -->
                                    <Border Width="16"
                                            Height="16"
                                            Margin="4,43,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#0A0A0A"
                                            CornerRadius="8">
                                        <sc:CachedImage Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="{x:Bind local:ZZZAvatarInfoPage.ProfessionIconUrl(Avatar.Profession)}" />
                                    </Border>
                                    <!--  影画  -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#A0000000"
                                            CornerRadius="0,8,0,4"
                                            Visibility="{x:Bind local:ZZZAvatarInfoPage.RankToVisibility(Avatar.Rank)}">
                                        <TextBlock Margin="4,2,4,2"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind Avatar.Rank}" />
                                    </Border>
                                </Grid>
                                <!--  名称  -->
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="12"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Grid>
                                            <Border x:Name="RootBackground"
                                                    Background="Transparent"
                                                    CornerRadius="8" />
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}" />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBackground" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBackground" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#14FFFFFF" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                                <VisualStateGroup x:Name="SelectionStates">
                                                    <VisualState x:Name="Unselected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBackground" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBackground" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="SelectedUnfocused">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBackground" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </ScrollViewer>
        </Grid>

        <!--  代理人详情  -->
        <ScrollViewer Grid.Column="1"
                      Margin="0,42,0,0"
                      VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="600"
                  Padding="8,0,24,24"
                  HorizontalAlignment="Center"
                  Visibility="{x:Bind CurrentAvatar, Converter={StaticResource ObjectToVisibilityConverter}}">
                <StackPanel Spacing="12">

                    <!--  头部区域  -->
                    <Grid Background="#2A2A2A"
                          CornerRadius="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  立绘  -->
                        <Grid Grid.Row="0"
                              Margin="8,8,8,8"
                              Background="{x:Bind local:ZZZAvatarInfoPage.PaintingBackgroundBrush(CurrentAvatar), Mode=OneWay}"
                              CornerRadius="8">
                            <!--  滚动背景字  -->
                            <Grid x:Name="MarqueeGrid"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <StackPanel x:Name="MarqueePanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="MarqueeText1"
                                               Padding="0,0,64,0"
                                               CharacterSpacing="60"
                                               FontFamily="Impact"
                                               FontSize="200"
                                               FontStyle="Italic"
                                               Foreground="{x:Bind local:ZZZAvatarInfoPage.MarqueeBrush(CurrentAvatar), Mode=OneWay}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind local:ZZZAvatarInfoPage.MarqueeText(CurrentAvatar.UsFullName), Mode=OneWay}" />
                                    <TextBlock x:Name="MarqueeText2"
                                               Margin="16,0,0,0"
                                               Padding="0,0,64,0"
                                               CharacterSpacing="60"
                                               FontFamily="Impact"
                                               FontSize="200"
                                               FontStyle="Italic"
                                               Foreground="{x:Bind local:ZZZAvatarInfoPage.MarqueeBrush(CurrentAvatar), Mode=OneWay}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind local:ZZZAvatarInfoPage.MarqueeText(CurrentAvatar.UsFullName), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <!--  立绘图片  -->
                            <sc:CachedImage x:Name="PaintingImage"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind CurrentAvatar.RoleVerticalPaintingUrl, Mode=OneWay}"
                                            SizeChanged="PaintingImage_SizeChanged" />
                        </Grid>
                        <Grid Grid.Row="1"
                              Margin="12,0,12,10">
                            <StackPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <!--  名称/属性/特性  -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="22"
                                           Height="22"
                                           VerticalAlignment="Center"
                                           Source="{x:Bind CurrentAvatar.Rarity, Converter={StaticResource ZZZRarityToIconConverter}, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="#E6FFFFFF"
                                               IsTextScaleFactorEnabled="False"
                                               Text="{x:Bind CurrentAvatar.FullName, Mode=OneWay}" />
                                    <Image Width="20"
                                           Height="20"
                                           VerticalAlignment="Center"
                                           Source="{x:Bind local:ZZZAvatarInfoPage.ElementIconUrl(CurrentAvatar.ElementType, CurrentAvatar.SubElementType), Mode=OneWay}" />
                                    <Image Width="20"
                                           Height="20"
                                           VerticalAlignment="Center"
                                           Source="{x:Bind local:ZZZAvatarInfoPage.ProfessionIconUrl(CurrentAvatar.Profession), Mode=OneWay}" />
                                </StackPanel>
                                <!--  等级/影画  -->
                                <Border HorizontalAlignment="Left"
                                        Padding="8,4,8,4"
                                        Background="#161817"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#E6FFFFFF"
                                                   IsTextScaleFactorEnabled="False">
                                            <Run Text="LV." /><Run Text="{x:Bind CurrentAvatar.Level, Mode=OneWay}" />
                                        </TextBlock>
                                        <Image x:Name="RankIcon1"
                                               Width="16"
                                               Height="16" />
                                        <Image x:Name="RankIcon2"
                                               Width="16"
                                               Height="16" />
                                        <Image x:Name="RankIcon3"
                                               Width="16"
                                               Height="16" />
                                        <Image x:Name="RankIcon4"
                                               Width="16"
                                               Height="16" />
                                        <Image x:Name="RankIcon5"
                                               Width="16"
                                               Height="16" />
                                        <Image x:Name="RankIcon6"
                                               Width="16"
                                               Height="16" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!--  阵营  -->
                            <Image Width="58"
                                   Height="58"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Source="{x:Bind CurrentAvatar.GroupIconPath, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Placement="Bottom" Content="{x:Bind CurrentAvatar.CampName, Mode=OneWay}" />
                                </ToolTipService.ToolTip>
                            </Image>
                        </Grid>
                    </Grid>

                    <!--  代理人属性  -->
                    <Grid CornerRadius="12">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_AvatarProperties}" />
                            </Grid>
                            <Grid Background="#161616">
                                <ItemsControl ItemsSource="{x:Bind local:ZZZAvatarInfoPage.AvatarPropertyRows(CurrentAvatar.Properties), Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ZZZAvatarPropertyRow">
                                            <Grid Background="{x:Bind local:ZZZAvatarInfoPage.AvatarPropertyRowBrush(Index)}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Grid.Column="0"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Content="{x:Bind Item1, Mode=OneWay}"
                                                                ContentTemplate="{StaticResource ZZZPropertyItemTemplate}" />
                                                <ContentControl Grid.Column="1"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Content="{x:Bind Item2, Mode=OneWay}"
                                                                ContentTemplate="{StaticResource ZZZPropertyItemTemplate}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  音擎  -->
                    <Grid CornerRadius="12"
                          Visibility="{x:Bind local:ZZZAvatarInfoPage.WeaponVisibility(CurrentAvatar), Mode=OneWay}">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Weapon}" />
                            </Grid>
                            <Grid Padding="12"
                                  Background="#2A2A2A">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <!--  音擎卡片（方形，悬浮显示效果名称与效果描述）  -->
                                    <Grid Width="80"
                                          Height="80">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Placement="Bottom">
                                                <StackPanel MaxWidth="360" Spacing="4">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="#FFFFFF"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind CurrentAvatar.Weapon.TalentTitle, Mode=OneWay}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="#73FFFFFF"
                                                               IsTextScaleFactorEnabled="False"
                                                               LineHeight="16"
                                                               Text="{x:Bind local:ZZZAvatarInfoPage.StripRichText(CurrentAvatar.Weapon.TalentContent), Mode=OneWay}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <Border Width="80"
                                                Height="80"
                                                Background="#0A0A0A"
                                                BorderBrush="#333534"
                                                BorderThickness="1.5"
                                                CornerRadius="8" />
                                        <sc:CachedImage Width="70"
                                                        Height="70"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="{x:Bind CurrentAvatar.Weapon.Icon, Mode=OneWay}" />
                                        <StackPanel Margin="0,0,0,4"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="0">
                                            <FontIcon FontSize="10"
                                                      Glyph="&#xE735;"
                                                      Foreground="{x:Bind local:ZZZAvatarInfoPage.WeaponStarBrush(CurrentAvatar.Weapon, 1), Mode=OneWay}" />
                                            <FontIcon FontSize="10"
                                                      Glyph="&#xE735;"
                                                      Foreground="{x:Bind local:ZZZAvatarInfoPage.WeaponStarBrush(CurrentAvatar.Weapon, 2), Mode=OneWay}" />
                                            <FontIcon FontSize="10"
                                                      Glyph="&#xE735;"
                                                      Foreground="{x:Bind local:ZZZAvatarInfoPage.WeaponStarBrush(CurrentAvatar.Weapon, 3), Mode=OneWay}" />
                                            <FontIcon FontSize="10"
                                                      Glyph="&#xE735;"
                                                      Foreground="{x:Bind local:ZZZAvatarInfoPage.WeaponStarBrush(CurrentAvatar.Weapon, 4), Mode=OneWay}" />
                                            <FontIcon FontSize="10"
                                                      Glyph="&#xE735;"
                                                      Foreground="{x:Bind local:ZZZAvatarInfoPage.WeaponStarBrush(CurrentAvatar.Weapon, 5), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <!--  音擎信息  -->
                                    <Grid Height="80"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!--  名称/等级  -->
                                        <StackPanel Grid.Row="0"
                                                    HorizontalAlignment="Stretch"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                            <TextBlock MaxWidth="360"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E6FFFFFF"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind CurrentAvatar.Weapon.Name, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border VerticalAlignment="Center"
                                                    Padding="4,1"
                                                    Background="#9D9D9D"
                                                    CornerRadius="3">
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#000000"
                                                           IsTextScaleFactorEnabled="False">
                                                    <Run Text="LV." /><Run Text="{x:Bind CurrentAvatar.Weapon.Level, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <!--  基础属性  -->
                                        <Border Grid.Row="1"
                                                Margin="0,4,0,0"
                                                Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="#161616"
                                                CornerRadius="12">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Width="56"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#59FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Properties}" />
                                                <TextBlock FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#A6FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind local:ZZZAvatarInfoPage.WeaponMainPropertyText(CurrentAvatar.Weapon), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <!--  高级属性  -->
                                        <Border Grid.Row="2"
                                                Margin="0,4,0,0"
                                                Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="#161616"
                                                CornerRadius="12">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Width="56"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#59FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_AdvancedProperties}" />
                                                <TextBlock FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#A6FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind local:ZZZAvatarInfoPage.WeaponAdvancedPropertyText(CurrentAvatar.Weapon), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  技能  -->
                    <Grid CornerRadius="12">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Skill}" />
                                    <StackPanel Margin="0,0,8,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind local:ZZZAvatarInfoPage.AwakenVisibility(CurrentAvatar), Mode=OneWay}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#73FFFFFF"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_PotentialAwaken}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#F0AC45"
                                                   IsTextScaleFactorEnabled="False"
                                                   Text="{x:Bind local:ZZZAvatarInfoPage.AwakenText(CurrentAvatar), Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Grid Padding="16,8"
                                  Background="#2A2A2A"
                                  CornerRadius="0,0,12,12">
                                <ItemsControl ItemsSource="{x:Bind local:ZZZAvatarInfoPage.OrderedSkills(CurrentAvatar), Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="scgz:ZZZSkill">
                                            <Button Margin="0,0,0,6"
                                                    Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <Image Width="40"
                                                           Height="40"
                                                           Source="{x:Bind local:ZZZAvatarInfoPage.SkillIconUrl(SkillType), Mode=OneWay}" />
                                                    <Border Margin="0,-6,0,0"
                                                            HorizontalAlignment="Center"
                                                            Padding="6,1"
                                                            Background="#000000"
                                                            CornerRadius="8">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#A6FFFFFF"
                                                                   IsTextScaleFactorEnabled="False"
                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.SkillLevelText(Level), Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <ScrollViewer MaxHeight="420" MaxWidth="420">
                                                            <StackPanel Margin="4" Spacing="12" MaxWidth="400">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Image Width="28"
                                                                           Height="28"
                                                                           Source="{x:Bind local:ZZZAvatarInfoPage.SkillIconUrl(SkillType), Mode=OneWay}" />
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               FontSize="14"
                                                                               FontWeight="Medium"
                                                                               Foreground="#FFFFFF"
                                                                               IsTextScaleFactorEnabled="False"
                                                                               Text="{x:Bind local:ZZZAvatarInfoPage.SkillTypeName(SkillType), Mode=OneWay}" />
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               FontSize="10"
                                                                               Foreground="#73FFFFFF"
                                                                               IsTextScaleFactorEnabled="False">
                                                                        <Run Text="Lv." /><Run Text="{x:Bind local:ZZZAvatarInfoPage.SkillLevelText(Level), Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{x:Bind Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="scgz:ZZZSkillItem">
                                                                            <StackPanel Margin="0,0,0,8">
                                                                                <TextBlock FontSize="12"
                                                                                           FontWeight="Medium"
                                                                                           Foreground="#E6FFFFFF"
                                                                                           IsTextScaleFactorEnabled="False"
                                                                                           Text="{x:Bind Title}"
                                                                                           TextWrapping="Wrap" />
                                                                                <TextBlock Margin="0,4,0,0"
                                                                                           FontSize="12"
                                                                                           Foreground="#73FFFFFF"
                                                                                           LineHeight="16"
                                                                                           Text="{x:Bind local:ZZZAvatarInfoPage.StripRichText(Text), Mode=OneWay}"
                                                                                           TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  驱动盘  -->
                    <Grid CornerRadius="12"
                          Visibility="{x:Bind local:ZZZAvatarInfoPage.EquipVisibility(CurrentAvatar), Mode=OneWay}">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Equip}" />
                            </Grid>
                            <Grid Padding="12,8"
                                  Background="#2A2A2A">
                                <StackPanel Spacing="12">
                                    <!--  评分  -->
                                    <Grid Padding="10,4,10,10"
                                          Background="{x:Bind local:ZZZAvatarInfoPage.RatingBackgroundBrush(CurrentAvatar.EquipPlanInfo), Mode=OneWay}"
                                          BorderBrush="#313030"
                                          BorderThickness="1"
                                          CornerRadius="9"
                                          Visibility="{x:Bind local:ZZZAvatarInfoPage.RatingVisibility(CurrentAvatar.EquipPlanInfo), Mode=OneWay}">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                                <TextBlock FontSize="14"
                                                           Foreground="#A6FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind local:ZZZAvatarInfoPage.HitCountText(CurrentAvatar.EquipPlanInfo), Mode=OneWay}" />
                                                <ItemsControl ItemsSource="{x:Bind CurrentAvatar.EquipPlanInfo.PlanEffectivePropertyList, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="scgz:ZZZPlanProperty">
                                                            <Border Padding="4,2"
                                                                    HorizontalAlignment="Left"
                                                                    Background="#2A2C2B"
                                                                    CornerRadius="4">
                                                                <TextBlock FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E6FFFFFF"
                                                                           IsTextScaleFactorEnabled="False"
                                                                           Text="{x:Bind FullName}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Image Width="80"
                                                       Height="44"
                                                       Source="{x:Bind local:ZZZAvatarInfoPage.RatingBadgeUrl(CurrentAvatar.EquipPlanInfo), Mode=OneWay}" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind local:ZZZAvatarInfoPage.RatingLevelText(CurrentAvatar.EquipPlanInfo), Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <!--  驱动盘 6 件  -->
                                    <ItemsRepeater ItemsSource="{x:Bind CurrentAvatar.Equip, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="200"
                                                               MinColumnSpacing="8"
                                                               MinRowSpacing="8"
                                                               ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="scgz:ZZZEquip">
                                                <Grid Background="#1A1A1A"
                                                      BorderBrush="#000000"
                                                      BorderThickness="2"
                                                      CornerRadius="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="50" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <!--  头部  -->
                                                    <Grid Background="#2A2A2A">
                                                        <Grid Padding="10,0,58,0">
                                                            <TextBlock VerticalAlignment="Top"
                                                                       Margin="0,5,0,0"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="#A6FFFFFF"
                                                                       IsTextScaleFactorEnabled="False"
                                                                       MaxLines="2"
                                                                       Text="{x:Bind Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="Wrap" />
                                                            <Border Margin="0,0,0,4"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="#161817"
                                                                    CornerRadius="6,2,2,6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Width="12"
                                                                               Height="12"
                                                                               Margin="4,0,0,0"
                                                                               Source="{x:Bind Rarity, Converter={StaticResource ZZZRarityToIconConverter}}" />
                                                                        <TextBlock Margin="2,0,4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="12"
                                                                                   Foreground="#A6FFFFFF"
                                                                   IsTextScaleFactorEnabled="False"
                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.EquipLevelText(Level), Mode=OneWay}" />
                                                                    </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                        <!--  驱动盘图标  -->
                                                        <Border Width="50"
                                                                Height="50"
                                                                Margin="0,2,4,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="#2A2A2A"
                                                                BorderBrush="#2A2A2A"
                                                                CornerRadius="30">
                                                            <Border CornerRadius="24">
                                                                <sc:CachedImage Height="45"
                                                                                Width="45"
                                                                                Source="{x:Bind Icon}" />
                                                            </Border>
                                                        </Border>
                                                    </Grid>
                                                    <!--  词条  -->
                                                    <StackPanel Grid.Row="1">
                                                        <Grid Height="28" Padding="8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{x:Bind local:ZZZAvatarInfoPage.PropertyValidBrush(MainProperties[0].Valid), Mode=OneWay}"
                                                                       IsTextScaleFactorEnabled="False"
                                                                       Text="{x:Bind MainProperties[0].PropertyName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{x:Bind local:ZZZAvatarInfoPage.PropertyValidBrush(MainProperties[0].Valid), Mode=OneWay}"
                                                                       IsTextScaleFactorEnabled="False"
                                                                       Text="{x:Bind MainProperties[0].Base}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Bind Properties}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="scgz:ZZZEquipProperty">
                                                                    <Grid Height="26" Padding="8,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="52" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <TextBlock VerticalAlignment="Center"
                                                                                       FontSize="10"
                                                                                       Foreground="{x:Bind local:ZZZAvatarInfoPage.SubPropertyBrush(Valid), Mode=OneWay}"
                                                                                       IsTextScaleFactorEnabled="False"
                                                                                       Text="{x:Bind PropertyName}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <Border Margin="4,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Padding="4,0"
                                                                                    Background="{x:Bind local:ZZZAvatarInfoPage.PropertyValidBrush(Valid), Mode=OneWay}"
                                                                                    CornerRadius="3"
                                                                                    Visibility="{x:Bind local:ZZZAvatarInfoPage.EquipAddVisibility(Add), Mode=OneWay}">
                                                                                <TextBlock FontSize="8"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#161817"
                                                                                           IsTextScaleFactorEnabled="False"
                                                                                           Text="{x:Bind local:ZZZAvatarInfoPage.EquipAddText(Add), Mode=OneWay}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="10"
                                                                                   Foreground="{x:Bind local:ZZZAvatarInfoPage.SubPropertyBrush(Valid), Mode=OneWay}"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   Text="{x:Bind Base}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!--  套装效果  -->
                                    <Grid Padding="12,8"
                                          Background="#161616"
                                          BorderBrush="#333333"
                                          BorderThickness="1"
                                          CornerRadius="10"
                                          Visibility="{x:Bind local:ZZZAvatarInfoPage.SuitEffectsVisibility(CurrentAvatar), Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="14"
                                                       Foreground="#E6FFFFFF"
                                                       IsTextScaleFactorEnabled="False"
                                                       Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_ActiveSuitEffect}" />
                                            <ItemsControl ItemsSource="{x:Bind local:ZZZAvatarInfoPage.SuitEffects(CurrentAvatar), Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ZZZSuitEffectItem">
                                                    <Button>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Border Padding="8,6"
                                                                Background="#2A2A2A"
                                                                CornerRadius="5">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Image Width="20"
                                                                       Height="20"
                                                                       VerticalAlignment="Center"
                                                                       Source="{x:Bind Icon}" />
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           Foreground="#E6FFFFFF"
                                                                           IsTextScaleFactorEnabled="False"
                                                                           Text="{x:Bind local:ZZZAvatarInfoPage.SuitOwnText(Suit.Name, Suit.Own), Mode=OneWay}" />
                                                                <FontIcon VerticalAlignment="Center"
                                                                          FontSize="8"
                                                                          Glyph="&#xE76C;" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <StackPanel Margin="4" MaxWidth="380" Spacing="8">
                                                                    <!--  2 件套效果  -->
                                                                    <StackPanel Spacing="4"
                                                                                Visibility="{x:Bind local:ZZZAvatarInfoPage.SuitEffectVisibility(Suit.Own, 2, Suit.Desc1), Mode=OneWay}">
                                                                        <TextBlock FontSize="12"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="#E6FFFFFF"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.SuitEffectTitle(Suit.Name, 2), Mode=OneWay}" />
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="#73FFFFFF"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   LineHeight="16"
                                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.StripRichText(Suit.Desc1), Mode=OneWay}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <!--  4 件套效果  -->
                                                                    <StackPanel Spacing="4"
                                                                                Visibility="{x:Bind local:ZZZAvatarInfoPage.SuitEffectVisibility(Suit.Own, 4, Suit.Desc2), Mode=OneWay}">
                                                                        <TextBlock FontSize="12"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="#E6FFFFFF"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.SuitEffectTitle(Suit.Name, 4), Mode=OneWay}" />
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="#73FFFFFF"
                                                                                   IsTextScaleFactorEnabled="False"
                                                                                   LineHeight="16"
                                                                                   Text="{x:Bind local:ZZZAvatarInfoPage.StripRichText(Suit.Desc2), Mode=OneWay}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  影画  -->
                    <Grid CornerRadius="12">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Rank}" />
                            </Grid>
                            <Grid Padding="12,4"
                                  Background="#2A2A2A">
                                <ItemsControl ItemsSource="{x:Bind CurrentAvatar.Ranks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="scgz:ZZZAvatarRank">
                                            <StackPanel Margin="0,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Width="24"
                                                           Height="24"
                                                           Loaded="RankListItemIcon_Loaded" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="#FFFFFF"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind Name}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#73FFFFFF"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind local:ZZZAvatarInfoPage.RankNumText(Pos), Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock Margin="32,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#73FFFFFF"
                                                           LineHeight="16"
                                                           Text="{x:Bind local:ZZZAvatarInfoPage.StripRichText(Desc), Mode=OneWay}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  时装  -->
                    <Grid CornerRadius="12"
                          Visibility="{x:Bind local:ZZZAvatarInfoPage.MultipleSkinsVisibility(CurrentAvatar), Mode=OneWay}">
                        <StackPanel>
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{x:Bind lang:Lang.ZZZAvatarInfoPage_Skin}" />
                            </Grid>
                            <Grid Padding="12"
                                  Background="#2A2A2A">
                                <ItemsControl ItemsSource="{x:Bind CurrentAvatar.SkinList, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="scgz:ZZZSkin">
                                            <StackPanel HorizontalAlignment="Center"
                                                        Opacity="{x:Bind local:ZZZAvatarInfoPage.SkinOpacity(Unlocked), Mode=OneWay}">
                                                <sc:CachedImage CornerRadius="8"
                                                                HorizontalAlignment="Center"
                                                                Source="{x:Bind SkinVerticalPaintingUrl}"
                                                                Stretch="Uniform" />
                                                <TextBlock Margin="0,4,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="#E6FFFFFF"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind SkinName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</sf:PageBase>