<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameRecord.ZZZ.ZZZRichTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameRecord.ZZZ"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <!--  WinUI 3 的 TextBlock 不支持 InlineUIContainer，需使用 RichTextBlock 渲染内联图标  -->
    <RichTextBlock x:Name="ThisRichTextBlock"
                   HorizontalAlignment="{x:Bind HorizontalAlignment}"
                   VerticalAlignment="{x:Bind VerticalAlignment}"
                   FontFamily="{x:Bind FontFamily}"
                   FontSize="{x:Bind FontSize}"
                   FontWeight="{x:Bind FontWeight}"
                   Foreground="{x:Bind Foreground}"
                   IsTextScaleFactorEnabled="False"
                   IsTextSelectionEnabled="False"
                   TextWrapping="{x:Bind TextWrapping}" />

</UserControl>
